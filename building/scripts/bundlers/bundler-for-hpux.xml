<!--
    See: docs/developer/building.md
    See: ivy.xml
-->
<project name="generate-hpux-bundles" basedir="${root}">

    <property name="bundler.message" value="Build Areca Backup bundle compatible with HP-UX"/>



    <target name="hpux-ia64">
        <echo message="${bundler.message} IA64"/>

        <property name="target.platform" value="hpux-ia64"/>

        <antcall target="hpux-bundler"/>
    </target>



    <target name="hpux-bundler" if="target.platform">
        <antcall target="unix-like-bundler"/>
    </target>

</project>