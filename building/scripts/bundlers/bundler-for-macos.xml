<!--
    See: docs/developer/building.md
    See: ivy.xml
-->
<project name="generate-macos-bundles" basedir="${root}">

    <property name="bundler.message" value="Build Areca Backup bundle compatible with macOS"/>



    <target name="macos-x86-64">
        <echo message="${bundler.message} x64 | AMD64 | x86-64 | x86_64 | Intel 64 | IA-32e | EM64T"/>

        <property name="target.platform" value="macos-x86-64"/>

        <antcall target="macos-bundler"/>
    </target>



    <target name="macos-x86-32">
        <echo message="${bundler.message} x32 | x86 | x86-32 | x86_32 | i586 | i686"/>

        <property name="target.platform" value="macos-x86-32"/>

        <antcall target="macos-bundler"/>
    </target>



    <target name="macos-bundler" if="target.platform">
        <antcall target="unix-like-bundler"/>
    </target>

</project>